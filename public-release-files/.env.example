# ===== 必填：域名配置 =====
ADMIN_URL=https://admin.yourdomain.com
H5_URL=https://h5.yourdomain.com
API_URL=https://api.yourdomain.com

# ===== 端口配置（仅HTTP，SSL由宝塔处理） =====
HTTP_PORT=8880

# ===== 数据库（首次运行自动生成强密码，请勿手动修改DB_PASSWORD和MYSQL_ROOT_PASSWORD） =====
DB_DATABASE=xinshangcheng003
DB_USERNAME=xinshangcheng
DB_PASSWORD=CHANGE_ME_ON_FIRST_RUN
MYSQL_ROOT_PASSWORD=CHANGE_ME_ON_FIRST_RUN

# ===== Redis =====
REDIS_PASSWORD=redis123123

# ===== 镜像版本（固定tag） =====
VERSION=v6.20260611.002
APP_VERSION=

# ===== Caddy镜像（国内服务器可切换阿里云镜像） =====
# CADDY_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/caddy:2-alpine

# ===== 备份 =====
BACKUP_RETENTION_DAYS=7

# ===== 系统配置 =====
APP_ENV=production
APP_EDITION=single
DEPLOYMENT_MODE=public_dockerhub
AGENT_TOOLKIT_DIR=/host/public-update-toolkit
